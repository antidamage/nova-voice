# Companion host (optional) — placeholders only.
#
# A companion is a second, independent inference host that does not contend for
# Iridium's GPU or its single llama.cpp slot, plus a source of Calendar,
# Reminders, location and Health context Iridium has no other way to see.
#
# The single-Iridium deployment remains the supported baseline. With
# COMPANION_ENABLED=false — the default — nothing here is consulted and the
# service behaves exactly as it did before this feature existed.
#
# Real hostnames, tailnet names, subnets and certificate paths belong in an
# untracked .env, never in this file. See PRIVATEREF.md.

# --- Rollback switches, in order of bluntness -------------------------------
# Each risky capability names the single switch that disables it (NPT-007).

# Master switch. False restores the previous Iridium-only behaviour exactly.
NOVA_VOICE_COMPANION_ENABLED=false

# Keeps personal tools working but stops the companion replacing any Iridium
# reasoning. Use this to isolate a suspected reasoning-quality regression
# without losing Calendar/Reminders access.
NOVA_VOICE_COMPANION_FORCE_LOCAL=false

# The two roles are independent. Muting the microphone and disabling the
# companion are separate acts, and neither implies the other.
NOVA_VOICE_COMPANION_SATELLITE_ENABLED=true
NOVA_VOICE_COMPANION_PERSONAL_PROVIDER_ENABLED=true

# --- Identity ---------------------------------------------------------------
# Empty means "any identity the household CA issued whose certificate matches
# the id it announces". Naming identities is an additional restriction, not the
# mechanism that makes the socket safe — the proof-of-possession exchange is.
# Comma-separated, e.g. companion-1
NOVA_VOICE_COMPANION_ALLOWED_IDENTITIES=

# How long a challenge nonce stays spendable. Single-use regardless.
NOVA_VOICE_COMPANION_AUTH_NONCE_TTL_SECONDS=30

# Migration only: accept satellite hellos carrying no identity proof. Set false
# once every native client has been upgraded (NPT-108/NPT-910).
NOVA_VOICE_COMPANION_ALLOW_UNBOUND_SATELLITES=true

# --- Locality ---------------------------------------------------------------
# Locality is derived from the peer address, never from what the device claims.
# A phone reporting atHome=true cannot unlock a home-LAN-only route.
#
# EMPTY MEANS NOTHING IS EVER home_lan. That is the correct failure direction
# for an unconfigured deployment: no route qualifies until you say which
# addresses are your home network.
# Comma-separated CIDRs, e.g. 10.0.0.0/24,fd00::/64
NOVA_VOICE_COMPANION_HOME_SUBNETS=

# Defaults to Tailscale's CGNAT range (100.64.0.0/10, fd7a:115c:a1e0::/48).
# Override only for a different overlay network.
NOVA_VOICE_COMPANION_TAILNET_SUBNETS=

# --- Battery and thermal tiers ----------------------------------------------
# Battery fractions at which participation steps down. Degradations apply
# immediately; recovering a tier needs the hysteresis headroom AND the dwell.
NOVA_VOICE_COMPANION_TIER_OFF_BELOW=0.15
NOVA_VOICE_COMPANION_TIER_ADVISORY_BELOW=0.25
NOVA_VOICE_COMPANION_TIER_REDUCED_BELOW=0.50
NOVA_VOICE_COMPANION_TIER_HYSTERESIS=0.05
NOVA_VOICE_COMPANION_TIER_DWELL_SECONDS=60

# Telemetry older than this stops the companion being offered work. Silence is
# not evidence of health.
NOVA_VOICE_COMPANION_TELEMETRY_STALE_SECONDS=180

# --- Deadlines and limits ---------------------------------------------------
# Ceilings, not per-job values: a job may ask for less and never for more.

# How many tool round-trips one job may make back through Iridium.
NOVA_VOICE_COMPANION_CALLBACK_CAP=12

# How long an offer waits to be accepted. Kept short and separate from the
# completion deadline: before acceptance, falling back costs one round trip.
NOVA_VOICE_COMPANION_ACCEPT_TIMEOUT_SECONDS=1.5

# Consecutive failures before a workload stops being offered, and for how long.
# A failing phone must not add its timeout to every turn.
NOVA_VOICE_COMPANION_FAILURE_BUDGET=3
NOVA_VOICE_COMPANION_BREAKER_PAUSE_SECONDS=120

# How long a proposed mutation waits for an approval before expiring unrun.
NOVA_VOICE_COMPANION_APPROVAL_TIMEOUT_SECONDS=300

# --- Arbitration ------------------------------------------------------------
# A phone microphone beats a room microphone on raw SNR, which is the wrong
# outcome: the fixed satellite in the room the speaker is standing in should
# win a near-tie. This penalty restores that without preventing genuinely
# clearer mobile audio from winning.
NOVA_VOICE_COMPANION_ELECTION_PENALTY=0.15
