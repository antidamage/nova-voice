.env
# Private household network/machine/PII reference — never commit or publish.
PRIVATEREF.md
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
data/
models/
certs/
inventory.local.json
benchmark-results/
output/
.playwright-cli/

# Cygwin/Git-Bash crash dumps (created anywhere a bash tool crashes).
bash.exe.stackdump
**/bash.exe.stackdump

# Household identity shipped into the companion build. A private key must
# never enter git; it is copied in at build time from the issuing host.
satellites/ios/NovaCompanion/companion-identity.p12

# Deployment endpoint, identity and passphrase for the companion build.
satellites/ios/NovaCompanion/companion-config.json

# The household CA, anchored by the app so Nova's own server certificate
# validates. Public material, but it names one deployment, so it is copied in
# at build time alongside the identity rather than tracked.
satellites/ios/NovaCompanion/household-ca.der
